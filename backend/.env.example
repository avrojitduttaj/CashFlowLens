# Change this to a long random secret before any public deployment.
CASHFLOWLENS_TOKEN_SECRET=tCPpBCjpy7JSQ1bc8d9c-lfOQcteUuxP0Fo-2XQwgKefZ5ZyWphcMw2F8BrjNBPh
# SQLite file path (defaults to backend/cashflowlens.sqlite3)
# CASHFLOWLENS_DB=./cashflowlens.sqlite3
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Local development default: the key is ignored and never sent for loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Remote gateways are allowed only when CASHFLOWLENS_ENV is explicitly set to
# production, OLLAMA_BASE_URL uses HTTPS, and OLLAMA_API_KEY is set on backend.
CASHFLOWLENS_ENV=development
# OLLAMA_BASE_URL=https://your-ollama-gateway.example.com
# OLLAMA_API_KEY=
